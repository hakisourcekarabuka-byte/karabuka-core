{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karabuka-core",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // 10 chat requests per minute per visitor IP
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ASSISTANT_NAME": "Haki",
    // sites allowed to show the chat widget (space-separated https origins)
    "EMBED_ORIGINS": "https://aziflow.com https://www.aziflow.com"
  }
}
